    PowerShellVersion = '5.1'

    # Explicit list generated from TCPK/Public/**/*.ps1. Kept in the manifest so:
    #   1. Get-Command -Module TCPK returns exactly the intended surface (no accidental
    #      leakage of a helper someone forgot to prefix underscore).
    #   2. PowerShell Gallery / any consumer that reads the manifest can index the cmdlet
    #      names without loading the module.
    #   3. Module load is fractionally faster because Export-ModuleMember does not have to
    #      walk every function definition to decide what is public.
    # Regenerate with: grep -rhE '^function\s+([A-Za-z-]+)' TCPK/Public/**/*.ps1
